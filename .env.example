# Public URL assigned by the host, without a trailing slash.
PUBLIC_ORIGIN=https://example.ru

# Enter these only in the hosting control panel. Never commit real passwords.
ROBOKASSA_MERCHANT_LOGIN=your-shop-id
ROBOKASSA_PASSWORD_1=replace-in-hosting-panel
ROBOKASSA_PASSWORD_2=replace-in-hosting-panel
ROBOKASSA_TEST_MODE=true

# Keep false until Robokassa confirms the correct B2B NPD receipt flow.
ROBOKASSA_B2B_RECEIPT_CONFIRMED=false

# Dedicated owner notification bot. Create it with @BotFather, message it once,
# then keep both values only in the hosting control panel.
TELEGRAM_BOT_TOKEN=replace-in-hosting-panel

# REQUIRED for reliable delivery. Get your numeric chat id (e.g. from
# @userinfobot) after messaging the bot once. Without this set, the app falls
# back to scanning the bot's recent getUpdates() history for
# TELEGRAM_OWNER_USERNAME, which is unreliable and can silently drop a paid
# customer's submission if the owner hasn't messaged the bot recently.
TELEGRAM_OWNER_CHAT_ID=replace-in-hosting-panel

# Fallback only, used if TELEGRAM_OWNER_CHAT_ID is not set. Defaults to kruger79.
TELEGRAM_OWNER_USERNAME=kruger79

# Optional relay, used when the main host cannot reach api.telegram.org
# directly (see app/api/telegram-relay for the relay endpoint, typically
# deployed separately, e.g. via relay-vercel/). Leave all three unset to call
# the Telegram API directly from this app instead.
TELEGRAM_RELAY_URL=
TELEGRAM_RELAY_SECRET=
TELEGRAM_RELAY_AUTH_TOKEN=

# Optional. Sends a short confirmation email to the customer after their
# intake form is received, using a Yandex mailbox over SMTP (smtp.yandex.ru,
# port 465). Create an app password in the Yandex Mail security settings —
# do not use the account's main login password. Leave both unset to skip
# sending confirmation emails entirely; Telegram delivery is unaffected.
YANDEX_SMTP_USER=
YANDEX_SMTP_PASSWORD=

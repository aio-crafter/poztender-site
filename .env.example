# Public URL assigned by the host, without a trailing slash.
PUBLIC_ORIGIN=https://example.ru

# Neon PostgreSQL connection string. Required: without it the checkout stays
# closed, because a payment that cannot be recorded must not be started. Enter
# it only in the hosting control panel — never commit a real connection string.
#
# TLS is configured here and nowhere else. There is no DATABASE_SSL variable:
# node-postgres merges the parsed connection string over any `ssl` option given
# in code, so a second setting would be silently discarded. One source only.
#
# Use sslmode=verify-full. Neon requires TLS and its certificate comes from a
# publicly trusted CA, so verify-full checks the chain and the hostname against
# Node's built-in trust store — no CA bundle needed. Do not use `require`:
# pg 8 still treats it as verify-full but warns that pg 9 will downgrade it to
# an unverified connection. `disable`, `allow` and `no-verify` are refused
# outright for a remote host.
#
# Format: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full
# Runtime uses the Neon *pooled* host; migrations use the *direct* host.
DATABASE_URL=postgresql://user:password@pooled-host.neon.tech/poztender?sslmode=verify-full

# Optional. Connection pool size; defaults to 5.
DATABASE_POOL_MAX=

# Optional. Bank details shown to business buyers on /payment/invoice, as free
# text (multi-line is fine). Robokassa accepts payments from individuals only,
# so organisations and sole traders pay by bank transfer instead. Leave unset
# and the page tells the buyer an invoice will be emailed to them.
BANK_TRANSFER_DETAILS=

# Enter these only in the hosting control panel. Never commit real passwords.
ROBOKASSA_MERCHANT_LOGIN=your-shop-id
ROBOKASSA_PASSWORD_1=replace-in-hosting-panel
ROBOKASSA_PASSWORD_2=replace-in-hosting-panel
ROBOKASSA_TEST_MODE=true

# The second, explicit confirmation required before live card payments are
# opened. The name is historical: Robokassa support has confirmed the service
# accepts payments from individuals only, so business buyers never go through
# Robokassa at all and this flag has nothing to do with B2B receipts any more.
# It is kept under its original name so the production environment does not
# have to be re-keyed. Live mode needs ROBOKASSA_TEST_MODE=false AND this set
# to true; anything else keeps the card checkout closed.
ROBOKASSA_B2B_RECEIPT_CONFIRMED=false

# TEMPORARY. Opens an internal ten-rouble tariff (plan=live-smoke) so the first
# real card payment through production costs 10 RUB instead of a full one. It
# is never linked from the site and the checkout answers 404 unless this is
# EXACTLY "true" — "True", "1" and "yes" all leave it closed. Turn it off after
# the rail is proven; no price changes, just this one variable.
ROBOKASSA_LIVE_SMOKE_TEST=false

# Dedicated owner notification bot. Create it with @BotFather, message it once,
# then keep both values only in the hosting control panel.
TELEGRAM_BOT_TOKEN=replace-in-hosting-panel

# REQUIRED for reliable delivery. Get your numeric chat id (e.g. from
# @userinfobot) after messaging the bot once. Without this set, the app falls
# back to scanning the bot's recent getUpdates() history for
# TELEGRAM_OWNER_USERNAME, which is unreliable and can silently drop a paid
# customer's submission if the owner hasn't messaged the bot recently.
TELEGRAM_OWNER_CHAT_ID=replace-in-hosting-panel

# Fallback only, used if TELEGRAM_OWNER_CHAT_ID is not set. Defaults to kruger79.
TELEGRAM_OWNER_USERNAME=kruger79

# Optional relay, used when the main host cannot reach api.telegram.org
# directly (see app/api/telegram-relay for the relay endpoint, typically
# deployed separately, e.g. via relay-vercel/). Leave all three unset to call
# the Telegram API directly from this app instead.
TELEGRAM_RELAY_URL=
TELEGRAM_RELAY_SECRET=
TELEGRAM_RELAY_AUTH_TOKEN=

# Email relay. REQUIRED on Timeweb: the host times out on smtp.yandex.ru:465
# and :587 alike, so outgoing mail goes over HTTPS to the relay deployed from
# relay-vercel/ (see app endpoint /api/email-relay) and the relay does the SMTP
# conversation. Set both or neither: a URL without a 32+ character secret is
# ignored and the app falls back to a direct SMTP connection.
#
# The SMTP password is NOT set on this host when the relay is used — it lives
# only in the relay's own environment and is never sent in a request.
EMAIL_RELAY_URL=
EMAIL_RELAY_SECRET=

# Optional. Sends a short confirmation email to the customer after their
# intake form is received, using a Yandex mailbox over SMTP (smtp.yandex.ru,
# port 465). Create an app password in the Yandex Mail security settings —
# do not use the account's main login password. Leave both unset to skip
# sending confirmation emails entirely; Telegram delivery is unaffected.
YANDEX_SMTP_USER=
YANDEX_SMTP_PASSWORD=
